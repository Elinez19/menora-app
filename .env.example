# Server Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/menora"

# Better Auth Server Secrets (NEVER expose to client)
BETTER_AUTH_SECRET="a_random_32_character_high_entropy_secret_here"
BETTER_AUTH_URL="http://localhost:8081"

# OAuth Providers (Optional / Configure for Social Sign-In)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Client Public API URL (Reachable by Expo mobile device / emulator)
# For iOS Simulator / Web: http://localhost:8081
# For Android Emulator: http://10.0.2.2:8081
# For Physical Device: http://<YOUR_LAN_IP>:8081
EXPO_PUBLIC_API_URL="http://localhost:8081"
